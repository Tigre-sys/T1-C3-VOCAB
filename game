<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Temas-1 Contexto 3 | Vocabulario</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Calibri', sans-serif;
            background: linear-gradient(135deg, #f5f5f5 0%, #e8e8e8 100%);
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            padding: 10px;
        }

        .container {
            width: 100%;
            max-width: 1000px;
            background: white;
            border-radius: 8px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
            overflow: hidden;
            background-image: url('T-1C3-BKG.jpg');
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
        }

        .overlay {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(255, 255, 255, 0.92);
            z-index: 1;
        }

        .content {
            position: relative;
            z-index: 2;
            padding: 40px 30px;
            min-height: 600px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
        }

        /* SETUP SCREEN */
        .screen {
            display: none;
            width: 100%;
        }

        .screen.active {
            display: block;
            animation: fadeIn 0.3s ease-in;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .setup-screen h1 {
            font-size: 2.5em;
            color: #1f3372;
            margin-bottom: 10px;
            font-weight: bold;
        }

        .setup-screen p {
            font-size: 1.1em;
            color: #666;
            margin-bottom: 40px;
        }

        .button-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-bottom: 30px;
            width: 100%;
            max-width: 500px;
        }

        .mode-btn, .play-btn, .start-btn {
            padding: 20px;
            font-size: 1.1em;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            transition: all 0.3s ease;
            font-weight: bold;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .mode-btn {
            background: #f0f0f0;
            color: #333;
            border: 3px solid #ddd;
        }

        .mode-btn:hover {
            background: #e0e0e0;
            border-color: #999;
        }

        .mode-btn.selected {
            background: #1f3372;
            color: white;
            border-color: #1f3372;
        }

        .play-btn {
            background: #f0f0f0;
            color: #333;
            border: 3px solid #ddd;
        }

        .play-btn:hover {
            background: #e0e0e0;
            border-color: #999;
        }

        .play-btn.selected {
            background: #00674a;
            color: white;
            border-color: #00674a;
        }

        .start-btn {
            background: #a59b68;
            color: white;
            padding: 18px 50px;
            font-size: 1.3em;
            margin-top: 20px;
        }

        .start-btn:hover {
            background: #8f8553;
            transform: scale(1.05);
        }

        .start-btn:disabled {
            background: #ccc;
            cursor: not-allowed;
            transform: none;
        }

        /* GAME SCREEN */
        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 40px;
            width: 100%;
            max-width: 700px;
        }

        .score, .timer {
            font-size: 1.8em;
            font-weight: bold;
            color: #1f3372;
        }

        .timer {
            color: #00674a;
        }

        .timer.warning {
            color: #d32f2f;
            animation: pulse 0.5s infinite;
        }

        @keyframes pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.7; }
        }

        .question-container {
            margin: 30px 0;
        }

        .question-label {
            font-size: 0.9em;
            color: #999;
            text-transform: uppercase;
            letter-spacing: 2px;
            margin-bottom: 15px;
        }

        .question {
            font-size: 2.2em;
            color: #1f3372;
            font-weight: bold;
            margin-bottom: 40px;
            word-wrap: break-word;
        }

        .answers {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
            margin-bottom: 30px;
            width: 100%;
            max-width: 700px;
        }

        @media (max-width: 600px) {
            .answers {
                grid-template-columns: 1fr;
            }
        }

        .answer-btn {
            padding: 18px;
            font-size: 1em;
            border: 3px solid #1f3372;
            background: white;
            color: #1f3372;
            border-radius: 6px;
            cursor: pointer;
            transition: all 0.2s ease;
            font-weight: 600;
            text-align: center;
            line-height: 1.4;
        }

        .answer-btn:hover:not(:disabled) {
            background: #1f3372;
            color: white;
            transform: scale(1.02);
        }

        .answer-btn:disabled {
            cursor: not-allowed;
        }

        .answer-btn.correct {
            background: #00674a;
            border-color: #00674a;
            color: white;
        }

        .answer-btn.incorrect {
            background: #d32f2f;
            border-color: #d32f2f;
            color: white;
        }

        .skip-btn {
            padding: 10px 25px;
            font-size: 0.95em;
            background: #f0f0f0;
            color: #666;
            border: 2px solid #ddd;
            border-radius: 6px;
            cursor: pointer;
            transition: all 0.3s ease;
            font-weight: 600;
        }

        .skip-btn:hover {
            background: #e0e0e0;
            border-color: #999;
        }

        /* RESULTS SCREEN */
        .results-screen h2 {
            font-size: 2.2em;
            color: #1f3372;
            margin-bottom: 30px;
        }

        .final-score {
            font-size: 3.5em;
            color: #00674a;
            font-weight: bold;
            margin: 30px 0;
        }

        .score-detail {
            font-size: 1.2em;
            color: #666;
            margin-bottom: 20px;
        }

        .restart-btn {
            background: #1f3372;
            color: white;
            padding: 18px 50px;
            font-size: 1.2em;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            transition: all 0.3s ease;
            font-weight: bold;
            margin-top: 30px;
        }

        .restart-btn:hover {
            background: #00674a;
            transform: scale(1.05);
        }

        @media (max-width: 768px) {
            .setup-screen h1 {
                font-size: 2em;
            }

            .question {
                font-size: 1.8em;
            }

            .answer-btn {
                font-size: 0.95em;
                padding: 16px;
            }

            .header {
                flex-direction: column;
                gap: 15px;
            }

            .button-grid {
                max-width: 100%;
            }

            .content {
                padding: 30px 20px;
            }
        }

        @media (max-width: 480px) {
            .setup-screen h1 {
                font-size: 1.6em;
            }

            .question {
                font-size: 1.4em;
            }

            .mode-btn, .play-btn {
                font-size: 0.95em;
                padding: 16px;
            }

            .final-score {
                font-size: 2.8em;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="overlay"></div>
        <div class="content">
            <!-- SETUP SCREEN -->
            <div class="screen setup-screen active">
                <h1>VOCABULARIO</h1>
                <p>Temas-1 Contexto 3</p>

                <div style="margin-bottom: 50px;">
                    <p style="margin-bottom: 20px; font-size: 1em; color: #333; font-weight: 600;">¿Qué modo prefieres?</p>
                    <div class="button-grid">
                        <button class="mode-btn" data-mode="spanish-spanish">
                            Español → Español
                        </button>
                        <button class="mode-btn" data-mode="spanish-english">
                            Español → English
                        </button>
                    </div>
                </div>

                <div style="margin-bottom: 50px;">
                    <p style="margin-bottom: 20px; font-size: 1em; color: #333; font-weight: 600;">¿Individual o grupo?</p>
                    <div class="button-grid">
                        <button class="play-btn" data-play="individual">
                            Individual
                        </button>
                        <button class="play-btn" data-play="group">
                            Grupo
                        </button>
                    </div>
                </div>

                <button class="start-btn" id="startBtn" disabled>EMPEZAR</button>
            </div>

            <!-- GAME SCREEN -->
            <div class="screen game-screen">
                <div class="header">
                    <div class="score">Puntos: <span id="scoreDisplay">0</span></div>
                    <div class="timer" id="timerDisplay">5:00</div>
                </div>

                <div class="question-container">
                    <div class="question-label" id="questionLabel">Palabra</div>
                    <div class="question" id="question">Cargando...</div>
                </div>

                <div class="answers" id="answersContainer"></div>

                <button class="skip-btn" id="skipBtn">Saltar (→)</button>
            </div>

            <!-- RESULTS SCREEN -->
            <div class="screen results-screen">
                <h2>¡Juego Terminado!</h2>
                <div class="final-score" id="finalScore">0</div>
                <div class="score-detail" id="scoreDetail">0 de 0 correctas</div>
                <button class="restart-btn" id="restartBtn">Jugar de Nuevo</button>
            </div>
        </div>
    </div>

    <script>
        const VOCAB = [
            { spanish: "ambiental", englishDef: "environmental", spanishDef: "que pertenece al medio ambiente" },
            { spanish: "aislado", englishDef: "isolated", spanishDef: "separado, lejano, distante" },
            { spanish: "el emplazamiento", englishDef: "location", spanishDef: "situación, colocación, ubicación" },
            { spanish: "agrícola", englishDef: "agricultural", spanishDef: "que pertenece a la agricultura" },
            { spanish: "la emigración", englishDef: "emigration", spanishDef: "desplazamiento desde el lugar de origen a otro lugar" },
            { spanish: "extranjero", englishDef: "foreign", spanishDef: "objeto o persona de otro país" },
            { spanish: "el entorno", englishDef: "environment", spanishDef: "ambiente" },
            { spanish: "el consumismo", englishDef: "consumerism", spanishDef: "tendencia al consumo excesivo e innecesario" },
            { spanish: "el éxodo", englishDef: "exodus", spanishDef: "emigración de un pueblo o muchedumbre de personas" },
            { spanish: "la congestión", englishDef: "congestion", spanishDef: "acumulación excesiva de algo" },
            { spanish: "la aglomeración", englishDef: "agglomeration", spanishDef: "muchedumbre, concentración de personas" },
            { spanish: "el arrendamiento", englishDef: "lease", spanishDef: "contrato para adquirir por pago el goce temporal de una propiedad" },
            { spanish: "el colonialismo", englishDef: "colonialism", spanishDef: "régimen en que un Estado explota y controla un territorio ajeno" },
            { spanish: "la explotación", englishDef: "exploitation", spanishDef: "conjunto de elementos destinados a sacar provecho de un producto" },
            { spanish: "la empresa", englishDef: "company", spanishDef: "entidad dedicada a actividades industriales o mercantiles con fines lucrativos" },
            { spanish: "la planificación", englishDef: "planning", spanishDef: "plan hecho metódicamente, de forma organizada" },
            { spanish: "el flujo", englishDef: "flow", spanishDef: "acción y efecto de fluir" },
            { spanish: "migratorio", englishDef: "migratory", spanishDef: "que se traslada del lugar donde habita" },
            { spanish: "la infraestructura", englishDef: "infrastructure", spanishDef: "elementos y sistemas necesarios para el funcionamiento adecuado de una región" },
            { spanish: "la tasa", englishDef: "rate", spanishDef: "medida, relación entre dos magnitudes" },
            { spanish: "la natalidad", englishDef: "birth rate", spanishDef: "tasa de nacimientos en población durante un tiempo determinado" },
            { spanish: "el paisaje", englishDef: "landscape", spanishDef: "extensión de campo que se ve desde un sitio; panorama" },
            { spanish: "la propiedad", englishDef: "property", spanishDef: "derecho o facultad de poseer algo" },
            { spanish: "el índice de", englishDef: "index of", spanishDef: "expresión numérica de la relación entre dos cantidades" },
            { spanish: "la nacionalización", englishDef: "nationalization", spanishDef: "efecto de naturalizar en un país a personas o cosas de otro país" },
            { spanish: "la xenofobia", englishDef: "xenophobia", spanishDef: "fobia a lo extranjero o a los extranjeros" },
            { spanish: "la mortalidad", englishDef: "mortality", spanishDef: "tasa de muertes en población durante un tiempo determinado" },
            { spanish: "la industrialización", englishDef: "industrialization", spanishDef: "desarrollo de industria y fabricación" },
            { spanish: "la materia prima", englishDef: "raw material", spanishDef: "materia que una industria necesita para transformarla en un producto" },
            { spanish: "el proteccionismo", englishDef: "protectionism", spanishDef: "política económica que complica la entrada de productos competidores" },
            { spanish: "la polarización", englishDef: "polarization", spanishDef: "disposición de las partes en dos direcciones contrarias" },
            { spanish: "el rendimiento", englishDef: "performance", spanishDef: "producto o resultado obtenido del trabajo" },
            { spanish: "la urbanización", englishDef: "urbanization", spanishDef: "núcleo residencial poblado" },
            { spanish: "la localización", englishDef: "location", spanishDef: "ubicación; colocación" },
            { spanish: "la mundialización", englishDef: "globalization", spanishDef: "producir un alcance mundial de algo" }
        ];

        let gameState = {
            mode: null,
            playType: null,
            score: 0,
            answered: 0,
            correct: 0,
            currentIndex: 0,
            timeLeft: 300,
            timerInterval: null,
            gameActive: false,
            usedIndices: new Set()
        };

        const setupScreen = document.querySelector('.setup-screen');
        const gameScreen = document.querySelector('.game-screen');
        const resultsScreen = document.querySelector('.results-screen');
        const startBtn = document.getElementById('startBtn');
        const restartBtn = document.getElementById('restartBtn');
        const skipBtn = document.getElementById('skipBtn');

        // Setup buttons
        document.querySelectorAll('.mode-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                document.querySelectorAll('.mode-btn').forEach(b => b.classList.remove('selected'));
                btn.classList.add('selected');
                gameState.mode = btn.dataset.mode;
                updateStartButton();
            });
        });

        document.querySelectorAll('.play-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                document.querySelectorAll('.play-btn').forEach(b => b.classList.remove('selected'));
                btn.classList.add('selected');
                gameState.playType = btn.dataset.play;
                updateStartButton();
            });
        });

        function updateStartButton() {
            startBtn.disabled = !gameState.mode || !gameState.playType;
        }

        startBtn.addEventListener('click', startGame);
        restartBtn.addEventListener('click', restart);
        skipBtn.addEventListener('click', nextQuestion);

        // Keyboard shortcut for skip
        document.addEventListener('keydown', (e) => {
            if (e.key === 'ArrowRight' && gameState.gameActive) {
                nextQuestion();
            }
        });

        function startGame() {
            gameState.score = 0;
            gameState.answered = 0;
            gameState.correct = 0;
            gameState.timeLeft = 300;
            gameState.gameActive = true;
            gameState.usedIndices = new Set();

            setupScreen.classList.remove('active');
            gameScreen.classList.add('active');

            startTimer();
            nextQuestion();
        }

        function getRandomQuestion() {
            let index;
            do {
                index = Math.floor(Math.random() * VOCAB.length);
            } while (gameState.usedIndices.has(index) && gameState.usedIndices.size < VOCAB.length);

            gameState.usedIndices.add(index);
            if (gameState.usedIndices.size === VOCAB.length) {
                gameState.usedIndices = new Set([index]);
            }

            return { index, item: VOCAB[index] };
        }

        function nextQuestion() {
            if (!gameState.gameActive) return;

            const { item } = getRandomQuestion();
            displayQuestion(item);
        }

        function displayQuestion(item) {
            const isSpaToSpan = gameState.mode === 'spanish-spanish';
            const questionLabel = document.getElementById('questionLabel');
            const questionEl = document.getElementById('question');
            const answersContainer = document.getElementById('answersContainer');

            questionEl.textContent = item.spanish;
            questionLabel.textContent = isSpaToSpan ? 'Definición en Español' : 'English Definition';

            // Get correct answer and 3 random wrong answers
            const correctAnswer = isSpaToSpan ? item.spanishDef : item.englishDef;
            const wrongAnswers = getWrongAnswers(correctAnswer, isSpaToSpan);
            const allAnswers = [correctAnswer, ...wrongAnswers].sort(() => Math.random() - 0.5);

            answersContainer.innerHTML = '';
            allAnswers.forEach((answer, idx) => {
                const btn = document.createElement('button');
                btn.className = 'answer-btn';
                btn.textContent = answer;
                btn.dataset.correct = answer === correctAnswer;

                btn.addEventListener('click', () => handleAnswer(btn, answer === correctAnswer));
                answersContainer.appendChild(btn);
            });

            // Disable skip button briefly
            skipBtn.disabled = true;
            setTimeout(() => { skipBtn.disabled = false; }, 100);
        }

        function getWrongAnswers(correct, isSpanish) {
            const pool = isSpanish
                ? VOCAB.map(v => v.spanishDef).filter(d => d !== correct)
                : VOCAB.map(v => v.englishDef).filter(d => d !== correct);

            const shuffled = pool.sort(() => Math.random() - 0.5);
            return shuffled.slice(0, 3);
        }

        function handleAnswer(btn, isCorrect) {
            document.querySelectorAll('.answer-btn').forEach(b => b.disabled = true);

            gameState.answered++;

            if (isCorrect) {
                btn.classList.add('correct');
                gameState.correct++;
                gameState.score += 10;
                document.getElementById('scoreDisplay').textContent = gameState.score;
            } else {
                btn.classList.add('incorrect');
                document.querySelectorAll('.answer-btn').forEach(b => {
                    if (b.dataset.correct === 'true') b.classList.add('correct');
                });
            }

            setTimeout(nextQuestion, 800);
        }

        function startTimer() {
            updateTimerDisplay();
            gameState.timerInterval = setInterval(() => {
                gameState.timeLeft--;
                updateTimerDisplay();

                if (gameState.timeLeft <= 0) {
                    endGame();
                }
            }, 1000);
        }

        function updateTimerDisplay() {
            const mins = Math.floor(gameState.timeLeft / 60);
            const secs = gameState.timeLeft % 60;
            const timerEl = document.getElementById('timerDisplay');
            timerEl.textContent = `${mins}:${secs < 10 ? '0' : ''}${secs}`;

            if (gameState.timeLeft <= 30) {
                timerEl.classList.add('warning');
            } else {
                timerEl.classList.remove('warning');
            }
        }

        function endGame() {
            gameState.gameActive = false;
            clearInterval(gameState.timerInterval);

            document.getElementById('finalScore').textContent = gameState.score;
            document.getElementById('scoreDetail').textContent = 
                `${gameState.correct} de ${gameState.answered} correctas`;

            gameScreen.classList.remove('active');
            resultsScreen.classList.add('active');
        }

        function restart() {
            gameState = {
                mode: null,
                playType: null,
                score: 0,
                answered: 0,
                correct: 0,
                currentIndex: 0,
                timeLeft: 300,
                timerInterval: null,
                gameActive: false,
                usedIndices: new Set()
            };

            document.querySelectorAll('.mode-btn, .play-btn').forEach(b => b.classList.remove('selected'));
            updateStartButton();

            resultsScreen.classList.remove('active');
            setupScreen.classList.add('active');
        }
    </script>
</body>
</html>
